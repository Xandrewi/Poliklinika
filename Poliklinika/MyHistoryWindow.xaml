<Window x:Class="Poliklinika.MyHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моя история" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B3E5FC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Шапка -->
            <RowDefinition Height="*"/>    <!-- Таблица -->
            <RowDefinition Height="Auto"/> <!-- Кнопка Назад -->
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <!-- Кнопка ВЫЙТИ -->
            <Button x:Name="btnExit" 
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="btnExit_Click"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Убедитесь, что файл Group 2.png добавлен в проект -->
                    <Image Source="/Group 2.png" Width="59" Height="64"/>
                    <TextBlock Text="ВЫЙТИ" FontSize="10" FontWeight="Bold" Foreground="#006064" 
                               HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                </StackPanel>
            </Button>

            <!-- Заголовок -->
            <Border Background="#00BCD4" 
                    CornerRadius="5" 
                    Padding="20,10" 
                    Margin="80,0,20,0" 
                    VerticalAlignment="Top" Height="50">
                <TextBlock Text="МОЯ ИСТОРИЯ"
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ТАБЛИЦА ИСТОРИИ (ИСПРАВЛЕНО) -->
        <!-- Теперь здесь DataGrid с именем dataGridHistory, чтобы C# код мог туда писать данные -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Background="#E1F5FE">
            <DataGrid x:Name="dataGridHistory"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="#E1F5FE"
                      AlternatingRowBackground="#D1EBFA"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="Black"
                      VerticalGridLinesBrush="Black"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      FontSize="14">
                
                <!-- Стиль заголовков столбцов -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E1F5FE"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Столбцы таблицы (должны совпадать с алиасами в SQL запросе) -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Дата}" Width="100"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding Услуга}" Width="*"/>
                    <DataGridTextColumn Header="Врач" Binding="{Binding Врач}" Width="*"/>
                    <DataGridTextColumn Header="Диагноз" Binding="{Binding Диагноз}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- КНОПКА НАЗАД -->
        <Button x:Name="btnBack" 
                Grid.Row="2" 
                Content="НАЗАД" 
                Width="200" Height="50"
                Margin="0,30,0,0"
                FontSize="16" FontWeight="Bold" Foreground="White"
                Click="btnBack_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#00838F" CornerRadius="25" BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>