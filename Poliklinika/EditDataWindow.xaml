<Window x:Class="Poliklinika.EditDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить данные" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B3E5FC">
    <!-- Светло-голубой фон -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Таблица полей -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <!-- Кнопка ВЫЙТИ -->
            <Button x:Name="btnExit" 
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="btnExit_Click"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Group 2.png" Width="69" Height="60"/>
                </StackPanel>
            </Button>

            <!-- Заголовок -->
            <Border Background="#00BCD4" 
                    CornerRadius="5" 
                    Padding="20,10" 
                    Margin="80,0,20,0" 
                    VerticalAlignment="Top" Height="50">
                <TextBlock Text="ИЗМЕНИТЬ ДАННЫЕ"
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ТАБЛИЦА ПОЛЕЙ ВВОДА -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Background="#E1F5FE">
            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <!-- Названия полей -->
                    <ColumnDefinition Width="*"/>
                    <!-- Поля ввода -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <!-- ФИО (Фамилия) -->
                    <RowDefinition Height="45"/>
                    <!-- Имя -->
                    <RowDefinition Height="45"/>
                    <!-- Отчество -->
                    <RowDefinition Height="45"/>
                    <!-- Адрес -->
                    <RowDefinition Height="45"/>
                    <!-- Телефон -->
                    <RowDefinition Height="45"/>
                    <!-- Почта -->
                    <RowDefinition Height="45"/>
                    <!-- Дата рождения -->
                    <RowDefinition Height="45"/>
                    <!-- Пол -->
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <!-- Стиль границ ячеек -->
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <!-- Стиль текста-label внутри ячейки -->
                    <Style x:Key="LabelStyle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <!-- Центрируем как на картинке -->
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                    <!-- Стиль полей ввода -->
                    <Style TargetType="TextBox">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="10,5"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </Grid.Resources>

                <!-- Ряд 1: Фамилия -->
                <Border Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Фамилия" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1">
                    <TextBox x:Name="txtSurname"/>
                </Border>

                <!-- Ряд 2: Имя -->
                <Border Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Имя" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1">
                    <TextBox x:Name="txtName"/>
                </Border>

                <!-- Ряд 3: Отчество -->
                <Border Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Отчество" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1">
                    <TextBox x:Name="txtPatronymic"/>
                </Border>

                <!-- Ряд 4: Адрес -->
                <Border Grid.Row="3" Grid.Column="0">
                    <TextBlock Text="Адрес" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1">
                    <TextBox x:Name="txtAddress"/>
                </Border>

                <!-- Ряд 5: Телефон -->
                <Border Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="Телефон" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="1">
                    <TextBox x:Name="txtPhone"/>
                </Border>

                <!-- Ряд 6: Почта -->
                <Border Grid.Row="5" Grid.Column="0">
                    <TextBlock Text="Почта" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="1">
                    <TextBox x:Name="txtEmail"/>
                </Border>

                <!-- Ряд 7: Дата рождения -->
                <Border Grid.Row="6" Grid.Column="0">
                    <TextBlock Text="Дата рождения" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="6" Grid.Column="1">
                    <DatePicker x:Name="dtpBirthDate" 
                                VerticalContentAlignment="Center" 
                                Margin="10,5" 
                                BorderThickness="0" 
                                Background="Transparent"/>
                </Border>

                <!-- Ряд 8: Пол -->
                <Border Grid.Row="7" Grid.Column="0">
                    <TextBlock Text="Пол" Style="{StaticResource LabelStyle}"/>
                </Border>
                <Border Grid.Row="7" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <RadioButton x:Name="rbMale" Content="М" GroupName="Gender" Margin="0,0,20,0" FontSize="14"/>
                        <RadioButton x:Name="rbFemale" Content="Ж" GroupName="Gender" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- КНОПКИ ВНИЗУ -->
        <Grid Grid.Row="2" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="50"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="25" BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Button x:Name="btnBack" 
                    Grid.Column="0" 
                    Content="НАЗАД" 
                    Background="#00838F" 
                    Margin="20,0,10,0"
                    Click="btnBack_Click"/>

            <Button x:Name="btnSave" 
                    Grid.Column="1" 
                    Content="СОХРАНИТЬ" 
                    Background="#00838F" 
                    Margin="10,0,20,0"
                    Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>