<Window x:Class="Poliklinika.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B3E5FC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Иконка больницы -->
        <Image Grid.Row="0"
               Source="/image 47.png"
               Width="104" Height="120"
               Margin="176,25,0,25"
               HorizontalAlignment="Left"/>

        <!-- Карточка авторизации -->
        <Border Grid.Row="1"
                Background="#29B6F6"
                CornerRadius="10"
                Padding="30"
                Margin="30,0">
            <StackPanel>
                <TextBlock Text="ОКНО АВТОРИЗАЦИИ"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- ПОЛЕ ЛОГИН -->
                <Grid Margin="0,0,0,15">
                    <TextBox x:Name="txtLogin"
                             Height="40"
                             FontSize="14"
                             Padding="10,0"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Background="White"
                             Tag="Логин"/>
                    <!-- Подсказка поверх поля -->
                    <TextBlock Text="Логин"
                               Foreground="Gray"
                               FontStyle="Italic"
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtLogin}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- ПОЛЕ ПАРОЛЬ -->
                <Grid Margin="0,0,0,25">
                    <PasswordBox x:Name="txtPassword"
                                 Height="40"
                                 FontSize="14"
                                 Padding="10,0"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Background="White"/>
                    <!-- Подсказка поверх поля -->
                    <TextBlock Text="Пароль"
                               Foreground="Gray"
                               FontStyle="Italic"
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Password, ElementName=txtPassword}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Кнопки -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnRegister"
                            Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                            Grid.Column="0"
                            Height="40"
                            Margin="0,0,5,0"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#0288D1"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnRegister_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="btnLogin"
                            Content="ВОЙТИ"
                            Grid.Column="1"
                            Height="40"
                            Margin="5,0,0,0"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#01579B"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>