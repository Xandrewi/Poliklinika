<Window x:Class="Poliklinika.AppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись на услугу" Height="700" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B3E5FC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Иконка и Дата -->
            <RowDefinition Height="Auto"/>
            <!-- Выбор врача (Новое!) -->
            <RowDefinition Height="Auto"/>
            <!-- Выбор услуги -->
            <RowDefinition Height="*"/>
            <!-- Пустое место -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="btnExit" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="btnExit_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Group 2.png" Width="52" Height="65"/>
                </StackPanel>
            </Button>

            <Border Background="#00BCD4" CornerRadius="5" Padding="20,10" 
                    Margin="80,0,20,0" VerticalAlignment="Top" Height="50">
                <TextBlock Text="ЗАПИСЬ НА УСЛУГУ" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ДАТА -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
            <TextBlock Text="" FontSize="40" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <DatePicker x:Name="dtpDate" Width="250" Height="35" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- ВЫБОР ВРАЧА (Обязательно для таблицы Appointment) -->
        <StackPanel Grid.Row="2" Margin="40,0">
            <TextBlock Text="Выберите врача:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbDoctor" Height="40" FontSize="14" Background="#D3D3D3" BorderThickness="0"/>
        </StackPanel>

        <!-- ВЫБОР УСЛУГИ -->
        <StackPanel Grid.Row="3" Margin="40,20,40,0">
            <TextBlock Text="Выберите услугу:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbService" Height="40" FontSize="14" Background="#D3D3D3" BorderThickness="0"/>
        </StackPanel>

        <!-- КНОПКИ -->
        <Grid Grid.Row="5" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="50"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="25" BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Button x:Name="btnBack" Grid.Column="0" Content="НАЗАД" Background="#00838F" 
                    Margin="20,0,10,0" Click="btnBack_Click"/>

            <Button x:Name="btnBook" Grid.Column="1" Content="ЗАПИСАТЬСЯ НА УСЛУГУ" Background="#00838F" 
                    Margin="10,0,20,0" Click="btnBook_Click"/>
        </Grid>
    </Grid>
</Window>