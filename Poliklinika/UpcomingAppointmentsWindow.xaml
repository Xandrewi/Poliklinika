<Window x:Class="Poliklinika.UpcomingAppointmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предстоящие записи" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B3E5FC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка Назад -->
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <!-- Кнопка ВЫЙТИ -->
            <Button x:Name="btnExit" 
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="btnExit_Click"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" Height="64">
                    <Image Source="/Group 2.png" Width="63" Height="59"/>
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#006064" 
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>

            <!-- Заголовок -->
            <Border Background="#00BCD4" 
                    CornerRadius="5" 
                    Padding="20,10" 
                    Margin="80,0,20,0" 
                    VerticalAlignment="Top" Height="50">
                <TextBlock Text="ПРЕДСТОЯЩИЕ ЗАПИСИ НА УСЛУГУ"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- ТАБЛИЦА ЗАПИСЕЙ -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Background="#E1F5FE">
            <DataGrid x:Name="dgAppointments"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="#E1F5FE"
                      AlternatingRowBackground="#D1EBFA"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="Black"
                      VerticalGridLinesBrush="Black"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      FontSize="14">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E1F5FE"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateService, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding TitleService}" Width="2*"/>
                    <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- КНОПКА НАЗАД -->
        <Button x:Name="btnBack" 
                Grid.Row="2" 
                Content="НАЗАД" 
                Width="200" Height="50"
                Margin="0,30,0,0"
                FontSize="16" FontWeight="Bold" Foreground="White"
                Click="btnBack_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#00838F" CornerRadius="25" BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>