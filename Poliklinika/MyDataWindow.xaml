<Window x:Class="Poliklinika.MyDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои данные" Height="550" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B3E5FC">
    <!-- Светло-голубой фон окна -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ (Заголовок и Выход) -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <!-- Кнопка ВЫЙТИ -->
            <Button x:Name="btnExit" 
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="btnExit_Click"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Group 2.png" Width="70" Height="66" RenderTransformOrigin="0.307,0.208"/>
                    <!-- Используем image49.png как иконку выхода -->

                </StackPanel>
            </Button>

            <!-- Синяя плашка заголовка -->
            <Border Background="#00BCD4" 
                    CornerRadius="5" 
                    Padding="20,10" 
                    Margin="80,0,20,0" 
                    VerticalAlignment="Top" Height="50">
                <TextBlock Text="МОИ ДАННЫЕ"
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ТАБЛИЦА ДАННЫХ -->
        <!-- Используем Grid с ShowGridLines или Border для имитации таблицы -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Background="#E1F5FE">
            <Grid ShowGridLines="False">
                <!-- Можно поставить True для отладки, но лучше Borders -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <!-- Колонка названий -->
                    <ColumnDefinition Width="*"/>
                    <!-- Колонка значений -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>

                <!-- Стиль для ячеек (границы) -->
                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                    <Style x:Key="CellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="15,0"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </Grid.Resources>

                <!-- Ряд 1: ФИО -->
                <Border Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="ФИО" Style="{StaticResource CellText}" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1">
                    <TextBlock x:Name="txtFio" Style="{StaticResource CellText}"/>
                </Border>

                <!-- Ряд 2: Дата рождения -->
                <Border Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Дата рождения" Style="{StaticResource CellText}" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1">
                    <TextBlock x:Name="txtBirthDate" Style="{StaticResource CellText}"/>
                </Border>

                <!-- Ряд 3: Телефон -->
                <Border Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Телефон" Style="{StaticResource CellText}" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1">
                    <TextBlock x:Name="txtPhone" Style="{StaticResource CellText}"/>
                </Border>

                <!-- Ряд 4: Пол -->
                <Border Grid.Row="3" Grid.Column="0">
                    <TextBlock Text="Пол" Style="{StaticResource CellText}" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1">
                    <TextBlock x:Name="txtGender" Style="{StaticResource CellText}"/>
                </Border>

                <!-- Ряд 5: Адрес -->
                <Border Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="Адрес" Style="{StaticResource CellText}" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="1">
                    <TextBlock x:Name="txtAddress" Style="{StaticResource CellText}"/>
                </Border>

                <!-- Ряд 6: Почта -->
                <Border Grid.Row="5" Grid.Column="0">
                    <TextBlock Text="Почта" Style="{StaticResource CellText}" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="1">
                    <TextBlock x:Name="txtEmail" Style="{StaticResource CellText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- КНОПКИ ВНИЗУ -->
        <Grid Grid.Row="2" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Общий стиль для кнопок -->
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="50"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="25" BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Кнопка НАЗАД -->
            <Button x:Name="btnBack" 
                    Grid.Column="0" 
                    Content="НАЗАД" 
                    Background="#00838F" 
                    Margin="20,0,10,0"
                    Click="btnBack_Click"/>

            <!-- Кнопка ИЗМЕНИТЬ -->
            <Button x:Name="btnEdit" 
                    Grid.Column="1" 
                    Content="ИЗМЕНИТЬ" 
                    Background="#00838F" 
                    Margin="10,0,20,0"
                    Click="btnEdit_Click"/>
        </Grid>
    </Grid>
</Window>