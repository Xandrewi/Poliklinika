<Window x:Class="Poliklinika.MainPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главная страница пациента" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B3E5FC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Кнопка Выйти -->
                <ColumnDefinition Width="*"/>
                <!-- Заголовок -->
                <ColumnDefinition Width="Auto"/>
                <!-- Колокольчик -->
            </Grid.ColumnDefinitions>

            <!-- КНОПКА ВЫЙТИ (С картинкой image49.png) -->
            <Button x:Name="btnExit" 
                    Grid.Column="0"
                    Click="btnExit_Click"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Выйти">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Синий круг под иконкой -->
                    <!-- Иконка выхода -->
                    <Image Source="/Group 2.png" 
                           Width="67" Height="72" 
                           Stretch="Uniform"
                           RenderTransformOrigin="0.546,0.271"/>


                    <!-- Иконка выхода -->

                </StackPanel>
            </Button>

            <!-- ЗАГОЛОВОК -->
            <Border Grid.Column="1" 
                    Background="#00BCD4" 
                    CornerRadius="5" 
                    Padding="20,10" 
                    Margin="20,0,20,0"
                    VerticalAlignment="Top" Height="50">
                <TextBlock Text="ГЛАВНАЯ СТРАНИЦА ПАЦИЕНТА"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- КОЛОКОЛЬЧИК (Картинка Group2.png) -->
            <Button x:Name="picBell" 
                    Grid.Column="2"
                    Background="Transparent" BorderThickness="0"
                    Width="60" Height="60" 
                    Click="picBell_Click"
                    VerticalAlignment="Top"
                    ToolTip="Уведомления">
                <Image Source="/image 49.png" 
                       Stretch="Uniform" 
                       Width="50" Height="50"/>
            </Button>
        </Grid>

        <!-- ОСНОВНЫЕ КНОПКИ МЕНЮ -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Top" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0">

            <StackPanel.Resources>
                <SolidColorBrush x:Key="MainBtnColor" Color="#00838F"/>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="450"/>
                    <Setter Property="Height" Value="70"/>
                    <Setter Property="Margin" Value="0,15"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="35" 
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <Button Content="МОИ ДАННЫЕ" Background="{StaticResource MainBtnColor}" Click="btnMyData_Click"/>
            <Button Content="МОЯ ИСТОРИЯ" Background="{StaticResource MainBtnColor}" Click="btnMyHistory_Click"/>
            <Button Content="ЗАПИСАТЬСЯ НА УСЛУГУ" Background="{StaticResource MainBtnColor}" Click="btnAppointment_Click"/>

        </StackPanel>
    </Grid>
</Window>